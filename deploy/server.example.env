# =============================================================================
# Inställningar för installationen på servern.
# Kopiera till deploy/server.env och fyll i. server.env skickas med koden till
# servern av skicka_kod.sh men checkas aldrig in i git.
# =============================================================================

# Webbplatsens domän. Underdomänerna härleds ur den: www.<domän> omdirigeras
# till <domän>, api.<domän> är REST-API:et, mcp.<domän> MCP-servern och
# stat.<domän> Umami. Alla fem behöver A- och AAAA-poster mot servern.
FORNMED_DOMAN=<DOMÄN>
