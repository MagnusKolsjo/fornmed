# =============================================================================
# Forntida och medeltida Sverige — Konfigurationsmall
# Kopiera till .env och fyll i värden. .env ska aldrig checkas in i git.
# =============================================================================

# -----------------------------------------------------------------------------
# Databas
# -----------------------------------------------------------------------------
# Lagringsbackend — välj ett av alternativen.
# PostgreSQL: kräver serverinstallation, ger GIN-index med svensk stemming
# och samtidiga skrivningar.
DATABASE_URL=postgresql://<ANVÄNDARE>:<LÖSENORD>@localhost:5432/<DATABASNAMN>

# SQLite: en lokal fil, ingen serverinstallation, FTS5 för fulltextsökning.
# DATABASE_URL=sqlite:///fornmed.db

# -----------------------------------------------------------------------------
# SDHK (Riksarkivet)
# -----------------------------------------------------------------------------
# Ögonblicksbild av SDHK-registret, CC BY 4.0. Riksarkivet publicerar nya
# versioner under nytt filnamn; byt URL när en ny version finns.
SDHK_CSV_URL=https://filer.riksarkivet.se/registerdata/SDHK/csv/sdhk_2411.csv

# Mall för länk till ett brev i Riksarkivets söktjänst; {nr} ersätts med SDHK-numret
# SDHK_POST_URL=https://sok.riksarkivet.se/sdhk?SDHK={nr}

# -----------------------------------------------------------------------------
# Ordböcker (Språkbanken)
# -----------------------------------------------------------------------------
# Katalog med Schlyters och Söderwalls LMF-filer, CC BY 4.0.
# ORDBOK_LMF_BAS_URL=https://svn.spraakbanken.gu.se/sb-arkiv/pub/lmf

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# Embedding-modell för regester och översättningar på modern svenska.
# Vektorkolumnerna har 768 dimensioner; en modell med annan dimension kräver
# att schemat ändras. Byte till en annan 768-dimensionell modell upptäcks och
# vektorerna räknas om vid nästa körning av berakna_embeddings.py.
EMBEDDING_MODELL=KBLab/sentence-bert-swedish-cased

# Embedding-modell för översättningar till andra moderna språk (danska,
# engelska) och för de latinska krönikorna och romerska texterna. Också 768
# dimensioner. Övriga originaltexter embeddas inte; se README. Vektorer från de
# två modellerna jämförs aldrig med varandra; var och en har ett eget index.
EMBEDDING_MODELL_FLERSPRAK=intfloat/multilingual-e5-base

# Batchstorlek vid embedding-generering (standard 32).
# Höj på maskiner med snabb GPU; sänk om minnet tar slut.
# EMBEDDING_BATCH_STORLEK=32

# -----------------------------------------------------------------------------
# Chunkning
# -----------------------------------------------------------------------------
# Max/min teckenlängd per chunk och överlapp mellan chunkar (standard 800/100/200).
# Texter som ryms i en chunk lämnas hela oavsett längd.
# CHUNK_MAX_TECKEN=800
# CHUNK_MIN_TECKEN=100
# CHUNK_OVERLAPP_TECKEN=200

# -----------------------------------------------------------------------------
# MCP-transport
# -----------------------------------------------------------------------------
# Transport-läge: stdio (lokal MCP-klient) eller http (delad drift).
MCP_TRANSPORT=stdio

# HTTP-transport — adress och port (används bara när MCP_TRANSPORT=http).
# MCP_HOST=127.0.0.1
# MCP_PORT=8010

# API-nyckel för Bearer-autentisering i http-läget. http-läget kräver
# antingen en nyckel eller öppet läsläge nedan; utan något av dem avbryts
# uppstarten.
# Generera med: python3 -c "import secrets; print(secrets.token_hex(32))"
# MCP_API_KEY=

# Öppet läsläge: http-läget utan nyckel. Bara för servrar där alla verktyg
# läser publikt material. En satt MCP_API_KEY gäller ändå.
# MCP_OPPEN_LASNING=på

# Publika värdnamn bakom reverse proxyn, kommaseparerade. MCP-biblioteket
# släpper annars bara igenom localhost.
# MCP_TILLATNA_VARDAR=mcp.<DOMÄN>

# -----------------------------------------------------------------------------
# Söktjänst (tjanst.py: API och MCP i samma process)
# -----------------------------------------------------------------------------
# FORNMED_HOST=127.0.0.1
# FORNMED_PORT=8424

# Skapa schemat vid start. På servern är databasen färdig och rollen får bara
# läsa, så där sätts av.
# FORNMED_INITIERA_SCHEMA=på

# -----------------------------------------------------------------------------
# Leverans till servern (deploy/skicka_databas.sh och leverans.py)
# -----------------------------------------------------------------------------
# Python med projektets paket, om den inte är .venv/bin/python i projektet.
# FORNMED_PYTHON=<SÖKVÄG>/bin/python

# pg_dump i serverns huvudversion (16). En kopia från en nyare pg_dump kan
# inte läsas av serverns pg_restore.
# FORNMED_PG_DUMP=/Applications/Postgres.app/Contents/Versions/16/bin/pg_dump

# ssh-namnet för servern i ~/.ssh/config
# FORNMED_SSH=fornmed
