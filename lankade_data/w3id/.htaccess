# Beständiga adresser för Fornmed: https://w3id.org/fornmed/
#
# Allt vidarebefordras med 303 till samma sökväg under https://fornmed.se/,
# där svaret väljs efter Accept-huvudet: en webbläsare får postens webbsida
# och ett program RDF. Frågesträngen (format=ttl) följer med.

Options +FollowSymLinks
RewriteEngine on

RewriteRule ^$ https://fornmed.se/ [R=303,L]
RewriteRule ^(.*)$ https://fornmed.se/$1 [R=303,L]
